{
  "name": "openchamber-session-export",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "metadata": {
    "version": "0.4.0",
    "creation": "2026-11-07",
    "last_updated": "2026-11-14"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lrq3000/openchamber-session-export.git"
  },
  "homepage": "https://github.com/lrq3000/openchamber-session-export#readme",
  "bugs": {
    "url": "https://github.com/lrq3000/openchamber-session-export/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.7.1"
    },
    "contributes": {
      "capabilities": ["sessions"],
      "opencodePlugin": "openchamber/plugin",
      "panel": {
        "id": "session-export",
        "name": "Session Export",
        "icon": "download-line",
        "entry": "openchamber/panel/index.html",
        "mobile": true
      },
      "actions": [
        {
          "id": "export-session",
          "label": "Export complete session",
          "icon": "download-line",
          "where": "session"
        }
      ],
      "service": {
        "entry": "openchamber/service.cjs",
        "runtime": "host",
        "provides": [
          "opencode"
        ],
        "permissions": {
          "exec": [
            "powershell.exe"
          ]
        }
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "build": "node scripts/build.mjs",
    "test:ui": "node --import tsx --test tests/ui/*.test.ts",
    "test:smoke": "node --import tsx --test tests/smoke/*.test.ts",
    "test:stress": "node --import tsx --test tests/stress/*.test.ts"
  },
  "dependencies": {
    "@openchamber/sdk": "2.7.1",
    "stream-json": "3.8.0",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
