{
  "name": "openchamber-session-export",
  "version": "0.4.0",
  "metadata": { "version": "0.4.0", "creation": "2026-11-07", "last_updated": "2026-11-14" },
  "openchamber": {
    "apiVersion": 1,
    "engines": { "openchamber": ">=2.7.1" },
    "contributes": {
      "capabilities": ["sessions"],
      "opencodePlugin": "plugin",
      "panel": { "id": "session-export", "name": "Session Export", "icon": "download-line", "entry": "panel/index.html", "mobile": true },
      "actions": [{ "id": "export-session", "label": "Export complete session", "icon": "download-line", "where": "session" }],
      "service": { "entry": "service.cjs", "runtime": "host", "provides": ["opencode"], "permissions": { "exec": ["powershell.exe"] } }
    }
  }
}
